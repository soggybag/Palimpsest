 179:Palimpsest.cpp **** 
 180:Palimpsest.cpp ****     char b[24];
 181:Palimpsest.cpp ****     int  ms = (int)(engine.LoopSeconds() * 1000.f + 0.5f);
 182:Palimpsest.cpp ****     snprintf(b, sizeof(b), "%d.%03ds", ms / 1000, ms % 1000);
 183:Palimpsest.cpp ****     hw.display.SetCursor(56, 0);
 184:Palimpsest.cpp ****     hw.display.WriteString(b, Font_7x10, true);
 185:Palimpsest.cpp **** 
 186:Palimpsest.cpp ****     // write / undo status, top-right
 187:Palimpsest.cpp ****     const char* w = engine.Substituting() ? "SUB"
 188:Palimpsest.cpp ****                     : engine.Overdubbing() ? "ODB"
 189:Palimpsest.cpp ****                     : engine.Undone()      ? "UND"
 190:Palimpsest.cpp ****                     : engine.CanUndo()     ? "u"
 191:Palimpsest.cpp ****                                            : "";
 192:Palimpsest.cpp ****     hw.display.SetCursor(110, 0);
 193:Palimpsest.cpp ****     hw.display.WriteString(w, Font_6x8, true);
 194:Palimpsest.cpp **** 
 195:Palimpsest.cpp ****     const int x0 = 0, x1 = 127, y0 = 20, y1 = 38;
 196:Palimpsest.cpp ****     hw.display.DrawRect(x0, y0, x1, y1, true);
 197:Palimpsest.cpp **** 
 198:Palimpsest.cpp ****     // window bracket: a filled bar just above the timeline (wraps if it spans
 199:Palimpsest.cpp ****     // the loop origin)
 200:Palimpsest.cpp ****     if(engine.Windowed())
 201:Palimpsest.cpp ****     {
 202:Palimpsest.cpp ****         int span = x1 - x0;
 203:Palimpsest.cpp ****         int ws   = x0 + (int)(engine.WinStartPhase() * (float)span);
 204:Palimpsest.cpp ****         int wpx  = (int)(engine.WinLenPhase() * (float)span);
 205:Palimpsest.cpp ****         if(wpx < 2)
 206:Palimpsest.cpp ****             wpx = 2;
 207:Palimpsest.cpp ****         int we = ws + wpx;
 208:Palimpsest.cpp ****         if(we <= x1)
 209:Palimpsest.cpp ****             hw.display.DrawRect(ws, y0 - 3, we, y0 - 1, true, true);
 210:Palimpsest.cpp ****         else
 211:Palimpsest.cpp ****         {
 212:Palimpsest.cpp ****             hw.display.DrawRect(ws, y0 - 3, x1, y0 - 1, true, true);
 213:Palimpsest.cpp ****             hw.display.DrawRect(x0, y0 - 3, x0 + (we - x1), y0 - 1, true, true);
 214:Palimpsest.cpp ****         }
 215:Palimpsest.cpp ****         char wb[16];
 216:Palimpsest.cpp ****         snprintf(wb, sizeof(wb), "W%dms", (int)(engine.WinMs() + 0.5f));
 217:Palimpsest.cpp ****         hw.display.SetCursor(88, 10);
 218:Palimpsest.cpp ****         hw.display.WriteString(wb, Font_6x8, true);
 219:Palimpsest.cpp ****     }
 220:Palimpsest.cpp **** 
 221:Palimpsest.cpp ****     if(engine.GetState() == Engine::State::PLAYING)
 222:Palimpsest.cpp ****     {
 223:Palimpsest.cpp ****         int px = x0 + (int)(engine.Phase() * (float)(x1 - x0));
 224:Palimpsest.cpp ****         hw.display.DrawLine(px, y0, px, y1, true);
 225:Palimpsest.cpp ****     }
