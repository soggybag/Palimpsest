  90:Palimpsest.cpp **** 
  91:Palimpsest.cpp **** // Echo latch/engaged state to the keypad LEDs: 0 off,1 red,2 cyan,3 green,5 dim.
  92:Palimpsest.cpp **** static void SendColours()
  93:Palimpsest.cpp **** {
  94:Palimpsest.cpp ****     static const uint8_t base[(int)Func::COUNT]
  95:Palimpsest.cpp ****         = {1, 1, 1, 2, 2, 2, 3}; // REC OVR SUB red; MUTE REV RET cyan; UNDO green
  96:Palimpsest.cpp ****     for(int i = 0; i < (int)Func::COUNT; i++)
  97:Palimpsest.cpp ****     {
  98:Palimpsest.cpp ****         uint8_t c = controls[(Func)i].Engaged() ? base[i] : 5;
  99:Palimpsest.cpp ****         if(c != s_col_sent[i])
 100:Palimpsest.cpp ****         {
 101:Palimpsest.cpp ****             uint8_t msg[3] = {0x90, kFuncNote[i], c};
 102:Palimpsest.cpp ****             hw.midi.SendMessage(msg, 3);
 103:Palimpsest.cpp ****             s_col_sent[i] = c;
 104:Palimpsest.cpp ****         }
 105:Palimpsest.cpp ****     }
 106:Palimpsest.cpp **** }
