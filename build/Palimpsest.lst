 1251              		.file 17 "src/Controls.h"
   1:src/Controls.h **** #pragma once
   2:src/Controls.h **** #include <cstddef>
   3:src/Controls.h **** #include <cstdint>
   4:src/Controls.h **** 
   5:src/Controls.h **** // Rule 2 — "length is the verb" — as one abstraction.
   6:src/Controls.h **** //
   7:src/Controls.h **** // Every performance function has a single event source, driven by a momentary
   8:src/Controls.h **** // contact (panel button or MIDI note) and/or a gate. Two flavours:
   9:src/Controls.h **** //
  10:src/Controls.h **** //   latching  (Reverse, Overdub, Substitute, Mute):
  11:src/Controls.h **** //     tap  -> toggle latch      hold -> momentary while held     gate -> level
  12:src/Controls.h **** //     read via Engaged() / RisingEdge() / Momentary()
  13:src/Controls.h **** //
  14:src/Controls.h **** //   impulse   (Record, Retrigger, Undo):
  15:src/Controls.h **** //     every press / gate-rising -> one Trigger()
  16:src/Controls.h **** //     a release after a >= kTapMs hold (or gate-falling) -> one ReleaseAfterHold()
  17:src/Controls.h **** //     latch is never used
  18:src/Controls.h **** //
  19:src/Controls.h **** // The engine only asks the accessors; it never cares whether a hand or a cable
  20:src/Controls.h **** // did it.
  21:src/Controls.h **** 
  22:src/Controls.h **** enum class Func : uint8_t
  23:src/Controls.h **** {
  24:src/Controls.h ****     RECORD = 0,
  25:src/Controls.h ****     OVERDUB,
  26:src/Controls.h ****     SUBSTITUTE,
  27:src/Controls.h ****     MUTE,
  28:src/Controls.h ****     REVERSE,
  29:src/Controls.h ****     RETRIGGER,
  30:src/Controls.h ****     UNDO,
  31:src/Controls.h ****     COUNT,
  32:src/Controls.h **** };
  33:src/Controls.h **** 
  34:src/Controls.h **** // MIDI note per function. Middle C (60) up — unambiguous in any MIDI tool, and
  35:src/Controls.h **** // what pico_rig/main.py sends as 60 + key_index.
  36:src/Controls.h **** static constexpr uint8_t kFuncNote[(int)Func::COUNT] = {
  37:src/Controls.h ****     60, // RECORD
  38:src/Controls.h ****     61, // OVERDUB
  39:src/Controls.h ****     62, // SUBSTITUTE
  40:src/Controls.h ****     63, // MUTE
  41:src/Controls.h ****     64, // REVERSE
  42:src/Controls.h ****     65, // RETRIGGER
  43:src/Controls.h ****     66, // UNDO
  44:src/Controls.h **** };
  45:src/Controls.h **** 
  46:src/Controls.h **** class FuncControl
  47:src/Controls.h **** {
ARM GAS  /var/folders/6p/t4mc160j56x7z12z3s_32gwm0000gn/T//ccHr3S02.s 			page 59


  48:src/Controls.h ****   public:
  49:src/Controls.h ****     void SetLatching(bool l) { latching_ = l; }
  50:src/Controls.h **** 
  51:src/Controls.h ****     void Press()
  52:src/Controls.h ****     {
  53:src/Controls.h ****         pressed_      = true;
  54:src/Controls.h ****         held_ms_      = 0.f;
  55:src/Controls.h ****         trig_pending_ = true;
  56:src/Controls.h ****     }
  57:src/Controls.h **** 
  58:src/Controls.h ****     void Release()
  59:src/Controls.h ****     {
  60:src/Controls.h ****         if(pressed_)
  61:src/Controls.h ****         {
  62:src/Controls.h ****             if(held_ms_ < kTapMs && latching_)
  63:src/Controls.h ****                 latch_ = !latch_; // tap -> toggle (latching funcs only)
  64:src/Controls.h ****             if(held_ms_ >= kTapMs)
  65:src/Controls.h ****                 relhold_pending_ = true; // release of a hold
  66:src/Controls.h ****         }
  67:src/Controls.h ****         pressed_ = false;
  68:src/Controls.h ****     }
  69:src/Controls.h **** 
  70:src/Controls.h ****     void SetGate(bool g)
  71:src/Controls.h ****     {
  72:src/Controls.h ****         if(g && !gate_)
  73:src/Controls.h ****             trig_pending_ = true; // gate rising == a press
  74:src/Controls.h ****         if(!g && gate_)
  75:src/Controls.h ****             relhold_pending_ = true; // gate falling == release of a hold
  76:src/Controls.h ****         gate_ = g;
  77:src/Controls.h ****     }
  78:src/Controls.h **** 
  79:src/Controls.h ****     void Tick(float dt_ms)
  80:src/Controls.h ****     {
  81:src/Controls.h ****         if(pressed_)
  82:src/Controls.h ****             held_ms_ += dt_ms;
  83:src/Controls.h **** 
  84:src/Controls.h ****         bool prev  = engaged_;
  85:src/Controls.h ****         engaged_   = latch_ || pressed_ || gate_;
  86:src/Controls.h ****         momentary_ = gate_ || (pressed_ && held_ms_ >= kTapMs);
  87:src/Controls.h ****         rising_    = engaged_ && !prev;
  88:src/Controls.h ****         falling_   = !engaged_ && prev;
  89:src/Controls.h ****     }
  90:src/Controls.h **** 
  91:src/Controls.h ****     // latching-style
  92:src/Controls.h ****     bool Engaged() const { return engaged_; }
  93:src/Controls.h ****     bool Momentary() const { return momentary_; }
  94:src/Controls.h ****     bool RisingEdge() const { return rising_; }
  95:src/Controls.h ****     bool FallingEdge() const { return falling_; }
  96:src/Controls.h ****     bool Latched() const { return latch_; }
  97:src/Controls.h ****     void ClearLatch() { latch_ = false; }
  98:src/Controls.h **** 
  99:src/Controls.h ****     // impulse-style (one-shot, consumed on read)
 100:src/Controls.h ****     bool Trigger()
 101:src/Controls.h ****     {
 102:src/Controls.h ****         bool t        = trig_pending_;
 103:src/Controls.h ****         trig_pending_ = false;
 104:src/Controls.h ****         return t;
ARM GAS  /var/folders/6p/t4mc160j56x7z12z3s_32gwm0000gn/T//ccHr3S02.s 			page 60


 105:src/Controls.h ****     }
 106:src/Controls.h ****     bool ReleaseAfterHold()
 107:src/Controls.h ****     {
 108:src/Controls.h ****         bool t           = relhold_pending_;
 109:src/Controls.h ****         relhold_pending_ = false;
 110:src/Controls.h ****         return t;
 111:src/Controls.h ****     }
 112:src/Controls.h **** 
 113:src/Controls.h ****   private:
 114:src/Controls.h ****     static constexpr float kTapMs = 300.f;
 115:src/Controls.h **** 
 116:src/Controls.h ****     bool  latching_        = true;
 117:src/Controls.h ****     bool  pressed_         = false;
 118:src/Controls.h ****     bool  gate_            = false;
 119:src/Controls.h ****     bool  latch_           = false;
 120:src/Controls.h ****     bool  engaged_         = false;
 121:src/Controls.h ****     bool  momentary_       = false;
 122:src/Controls.h ****     bool  rising_          = false;
 123:src/Controls.h ****     bool  falling_         = false;
 124:src/Controls.h ****     bool  trig_pending_    = false;
 125:src/Controls.h ****     bool  relhold_pending_ = false;
 126:src/Controls.h ****     float held_ms_         = 0.f;
 127:src/Controls.h **** };
