   5:src/Snapshot.h **** 
   6:src/Snapshot.h **** // Block copy-on-write layer shared by Overdub, Substitute, and Undo.
   7:src/Snapshot.h **** //
   8:src/Snapshot.h **** // The loop buffer is divided into fixed blocks. Before a destructive write first
   9:src/Snapshot.h **** // touches a block within a "take", that block is copied into a pool slot. Ending
  10:src/Snapshot.h **** // a take either COMMITS (the take's snapshots become the one-deep undo set) or
  11:src/Snapshot.h **** // REVERTS (snapshots are restored and discarded, and any prior committed undo
  12:src/Snapshot.h **** // survives).
  13:src/Snapshot.h **** //
  14:src/Snapshot.h **** // Undo swaps live <-> snapshot for the committed set; Undo again = redo.
  15:src/Snapshot.h **** //
  16:src/Snapshot.h **** // Pool exhausted -> the ring allocator drops the oldest un-kept snapshot and
  17:src/Snapshot.h **** // that region becomes un-undoable. No allocation, no blocking.
  18:src/Snapshot.h **** class Snapshot
  19:src/Snapshot.h **** {
  20:src/Snapshot.h ****   public:
  21:src/Snapshot.h ****     static constexpr uint32_t kBlock     = 4096;   // ~85 ms @ 48 kHz
  22:src/Snapshot.h ****     static constexpr uint16_t kNone      = 0xFFFF;
  23:src/Snapshot.h ****     static constexpr int      kMaxBlocks = 4700;   // covers 19.2 M-sample buffer
  24:src/Snapshot.h ****     static constexpr int      kMaxSlots  = 2048;   // 16 MB / 2 B / kBlock
  25:src/Snapshot.h **** 
  26:src/Snapshot.h ****     void Init(int16_t* pool, size_t pool_samps, size_t buf_samps)
  27:src/Snapshot.h ****     {
  28:src/Snapshot.h ****         pool_       = pool;
ARM GAS  /var/folders/6p/t4mc160j56x7z12z3s_32gwm0000gn/T//ccHr3S02.s 			page 243


  29:src/Snapshot.h ****         n_slots_    = (int)(pool_samps / kBlock);
  30:src/Snapshot.h ****         if(n_slots_ > kMaxSlots)
  31:src/Snapshot.h ****             n_slots_ = kMaxSlots;
  32:src/Snapshot.h ****         buf_samps_  = buf_samps;
  33:src/Snapshot.h ****         next_slot_  = 0;
  34:src/Snapshot.h ****         take_n_     = 0;
  35:src/Snapshot.h ****         undo_n_     = 0;
  36:src/Snapshot.h ****         undone_     = false;
  37:src/Snapshot.h ****         for(int i = 0; i < kMaxBlocks; i++)
  38:src/Snapshot.h ****         {
  39:src/Snapshot.h ****             take_slot_[i] = kNone;
  40:src/Snapshot.h ****             undo_slot_[i] = kNone;
  41:src/Snapshot.h ****         }
  42:src/Snapshot.h ****         for(int i = 0; i < kMaxSlots; i++)
  43:src/Snapshot.h ****         {
  44:src/Snapshot.h ****             slot_owner_[i] = kNone;
  45:src/Snapshot.h ****             slot_kept_[i]  = false;
  46:src/Snapshot.h ****         }
  47:src/Snapshot.h ****     }
  48:src/Snapshot.h **** 
  49:src/Snapshot.h ****     bool CanUndo() const { return undo_n_ > 0; }
  50:src/Snapshot.h ****     bool IsUndone() const { return undone_; }
  51:src/Snapshot.h **** 
  52:src/Snapshot.h ****     // Start a fresh destructive take (rising edge of Overdub / Substitute).
  53:src/Snapshot.h ****     void BeginTake()
