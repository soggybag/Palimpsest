 396:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     char WriteChar(char ch, FontDef font, bool on) override
 397:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     {
 398:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         uint32_t i, b, j;
 399:../../DaisyExamples/libDaisy/src/hid/disp/display.h **** 
 400:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         // Check if character is valid
 401:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         if(ch < 32 || ch > 126)
 402:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             return 0;
 403:../../DaisyExamples/libDaisy/src/hid/disp/display.h **** 
 404:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         // Check remaining space on current line
 405:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         if(Width() < (currentX_ + font.FontWidth)
 406:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****            || Height() < (currentY_ + font.FontHeight))
 407:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         {
 408:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             // Not enough space on current line
 409:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             return 0;
 410:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         }
 411:../../DaisyExamples/libDaisy/src/hid/disp/display.h **** 
 412:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         // Use the font to write
 413:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         for(i = 0; i < font.FontHeight; i++)
 414:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         {
 415:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             b = font.data[(ch - 32) * font.FontHeight + i];
 416:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             for(j = 0; j < font.FontWidth; j++)
 417:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             {
 418:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                 if((b << j) & 0x8000)
 419:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                 {
 420:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                     ((ChildType*)(this))
 421:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                         ->ChildType::DrawPixel(
 422:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                             currentX_ + j, (currentY_ + i), on);
 423:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                 }
 424:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                 else
 425:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                 {
 426:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                     ((ChildType*)(this))
 427:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                         ->ChildType::DrawPixel(
 428:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                             currentX_ + j, (currentY_ + i), !on);
 429:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****                 }
 430:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****             }
 431:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         }
 432:../../DaisyExamples/libDaisy/src/hid/disp/display.h **** 
 433:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         // The current space is now taken
