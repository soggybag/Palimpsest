  60:src/Snapshot.h ****                 slot_owner_[s]        = kNone;
  61:src/Snapshot.h ****                 take_slot_[take_blk_[i]] = kNone;
  62:src/Snapshot.h ****             }
  63:src/Snapshot.h ****         }
  64:src/Snapshot.h ****         take_n_ = 0;
  65:src/Snapshot.h ****     }
