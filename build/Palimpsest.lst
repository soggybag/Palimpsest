 263:Palimpsest.cpp ****     snprintf(b, sizeof(b), "CPU%2d%%", cpul);
 264:Palimpsest.cpp ****     hw.display.SetCursor(80, 54);
 265:Palimpsest.cpp ****     hw.display.WriteString(b, Font_6x8, true);
