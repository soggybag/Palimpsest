   1:Palimpsest.cpp **** // Palimpsest — M1b: unified control layer + MIDI in.
   2:Palimpsest.cpp **** //
   3:Palimpsest.cpp **** // Every function now runs through Controls (tap = latch, hold = momentary, gate
   4:Palimpsest.cpp **** // = level), fed by MIDI notes (Pico RGB Keypad or any MIDI keyboard, notes
   5:Palimpsest.cpp **** // 36..42) and/or the panel. Colour state is echoed back over MIDI so the keypad
   6:Palimpsest.cpp **** // LEDs show the contract.
   7:Palimpsest.cpp **** //
   8:Palimpsest.cpp **** //   note 36 / encoder / GATE_IN_1   Record   (edge = advance EMPTY->REC->PLAY->EMPTY)
   9:Palimpsest.cpp **** //   note 37                         Overdub  (M3)
  10:Palimpsest.cpp **** //   note 38                         Substitute (M3)
  11:Palimpsest.cpp **** //   note 39                         Mute     (M5)
  12:Palimpsest.cpp **** //   note 40 / CTRL_3>0.5            Reverse
  13:Palimpsest.cpp **** //   note 41 / GATE_IN_2             Retrigger / stutter
  14:Palimpsest.cpp **** //   note 42                         Undo     (M3)
  15:Palimpsest.cpp **** //   CTRL_1  Feedback     CTRL_2  Speed (detented, CV sums)
  16:Palimpsest.cpp **** 
  17:Palimpsest.cpp **** #include <cmath>
  18:Palimpsest.cpp **** #include <cstdio>
  19:Palimpsest.cpp **** #include "daisy_patch.h"
  20:Palimpsest.cpp **** #include "daisysp.h"
  21:Palimpsest.cpp **** #include "util/CpuLoadMeter.h"
  22:Palimpsest.cpp **** #include "src/LoopBuffer.h"
  23:Palimpsest.cpp **** #include "src/LoopReader.h"
  24:Palimpsest.cpp **** #include "src/Engine.h"
  25:Palimpsest.cpp **** #include "src/Controls.h"
ARM GAS  /var/folders/6p/t4mc160j56x7z12z3s_32gwm0000gn/T//ccHr3S02.s 			page 50


  26:Palimpsest.cpp **** 
  27:Palimpsest.cpp **** using namespace daisy;
  28:Palimpsest.cpp **** using namespace daisysp;
  29:Palimpsest.cpp **** 
  30:Palimpsest.cpp **** DaisyPatch     hw;
  31:Palimpsest.cpp **** MidiUsbHandler midi_usb; // "Daisy" USB-MIDI device (share the flashing cable)
  32:Palimpsest.cpp **** LoopBuffer     loop;
  33:Palimpsest.cpp **** Snapshot       snap;
  34:Palimpsest.cpp **** Engine         engine;
  35:Palimpsest.cpp **** Controls       controls;
  36:Palimpsest.cpp **** CpuLoadMeter   cpu;
  37:Palimpsest.cpp **** 
  38:Palimpsest.cpp **** constexpr size_t kBufSamples  = 48000u * 400u;      // 38.4 MB loop buffer
  39:Palimpsest.cpp **** constexpr size_t kPoolSamples = 8u * 1024u * 1024u; // 16 MB snapshot pool
  40:Palimpsest.cpp **** static int16_t DSY_SDRAM_BSS s_buf[kBufSamples];
  41:Palimpsest.cpp **** static int16_t DSY_SDRAM_BSS s_pool[kPoolSamples];
  42:Palimpsest.cpp **** 
  43:Palimpsest.cpp **** static float   s_dt_ms                      = 0.f;
  44:Palimpsest.cpp **** static bool    s_enc_pressed                = false;
  45:Palimpsest.cpp **** static uint8_t s_col_sent[(int)Func::COUNT] = {0};
  46:Palimpsest.cpp **** static float   s_cpu_peak                   = 0.f; // peak load, last ~1 s window
  47:Palimpsest.cpp **** 
  48:Palimpsest.cpp **** static float FeedbackFromKnob()
  49:Palimpsest.cpp **** {
  50:Palimpsest.cpp ****     float k = hw.GetKnobValue(DaisyPatch::CTRL_1);
  51:Palimpsest.cpp ****     return fclamp((k - 0.03f) / 0.94f, 0.f, 1.f);
  52:Palimpsest.cpp **** }
  53:Palimpsest.cpp **** 
  54:Palimpsest.cpp **** static float SpeedFromKnob()
  55:Palimpsest.cpp **** {
  56:Palimpsest.cpp ****     float k = hw.GetKnobValue(DaisyPatch::CTRL_2);
  57:Palimpsest.cpp ****     float s = powf(2.f, (k - 0.5f) * 4.f);
  58:Palimpsest.cpp ****     if(fabsf(s - 0.5f) < 0.03f)
  59:Palimpsest.cpp ****         s = 0.5f;
  60:Palimpsest.cpp ****     else if(fabsf(s - 1.0f) < 0.04f)
  61:Palimpsest.cpp ****         s = 1.0f;
  62:Palimpsest.cpp ****     else if(fabsf(s - 2.0f) < 0.06f)
  63:Palimpsest.cpp ****         s = 2.0f;
  64:Palimpsest.cpp ****     return s;
  65:Palimpsest.cpp **** }
  66:Palimpsest.cpp **** 
  67:Palimpsest.cpp **** static void RouteMidiEvent(MidiEvent m)
  68:Palimpsest.cpp **** {
  69:Palimpsest.cpp ****     if(m.type == NoteOn)
  70:Palimpsest.cpp ****     {
  71:Palimpsest.cpp ****         NoteOnEvent n = m.AsNoteOn();
  72:Palimpsest.cpp ****         controls.Note(n.note, n.velocity > 0);
  73:Palimpsest.cpp ****     }
  74:Palimpsest.cpp ****     else if(m.type == NoteOff)
  75:Palimpsest.cpp ****     {
  76:Palimpsest.cpp ****         controls.Note(m.AsNoteOff().note, false);
  77:Palimpsest.cpp ****     }
  78:Palimpsest.cpp **** }
  79:Palimpsest.cpp **** 
