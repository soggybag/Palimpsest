 121:src/Snapshot.h ****     // End the take, restoring the buffer. Prior undo set is untouched.
 122:src/Snapshot.h ****     void RevertTake(LoopBuffer& buf)
 123:src/Snapshot.h ****     {
 124:src/Snapshot.h ****         for(int i = 0; i < take_n_; i++)
 125:src/Snapshot.h ****         {
 126:src/Snapshot.h ****             uint16_t blk = take_blk_[i];
 127:src/Snapshot.h ****             uint16_t s   = take_slot_[blk];
 128:src/Snapshot.h ****             if(s == kNone)
 129:src/Snapshot.h ****                 continue;
 130:src/Snapshot.h ****             RestoreBlock(buf, blk, s);
 131:src/Snapshot.h ****             slot_owner_[s]  = kNone;
 132:src/Snapshot.h ****             take_slot_[blk] = kNone;
 133:src/Snapshot.h ****         }
 134:src/Snapshot.h ****         take_n_ = 0;
 135:src/Snapshot.h ****     }
 136:src/Snapshot.h **** 
 137:src/Snapshot.h ****     // Toggle the committed undo set (undo <-> redo).
 138:src/Snapshot.h ****     void UndoRedo(LoopBuffer& buf)
 139:src/Snapshot.h ****     {
 140:src/Snapshot.h ****         for(int i = 0; i < undo_n_; i++)
 141:src/Snapshot.h ****             SwapBlock(buf, undo_blk_[i], undo_slot_[undo_blk_[i]]);
 142:src/Snapshot.h ****         undone_ = !undone_;
 143:src/Snapshot.h ****     }
