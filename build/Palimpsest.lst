  44:src/LoopBuffer.h ****     // Bit-exact int16 access for the snapshot layer.
  45:src/LoopBuffer.h ****     inline int16_t Raw(size_t i) const { return buf_[i]; }
  46:src/LoopBuffer.h ****     inline void    SetRaw(size_t i, int16_t v) { buf_[i] = v; }
