   1:src/LoopReader.h **** #pragma once
   2:src/LoopReader.h **** #include <cmath>
   3:src/LoopReader.h **** #include <cstddef>
   4:src/LoopReader.h **** #include "LoopBuffer.h"
   5:src/LoopReader.h **** 
   6:src/LoopReader.h **** // Fractional read pointer over a window [wstart, wstart+wlen) inside a loop of
   7:src/LoopReader.h **** // loopLen samples. Buffer addressing wraps at loopLen; the window wraps at wlen.
   8:src/LoopReader.h **** //
   9:src/LoopReader.h **** //  - window boundary: equal-power tail->head crossfade (scaled to the window);
  10:src/LoopReader.h **** //    resume-offset + increment compensation keep the audible period = wlen/speed.
ARM GAS  /var/folders/6p/t4mc160j56x7z12z3s_32gwm0000gn/T//ccHr3S02.s 			page 74


  11:src/LoopReader.h **** //  - windows shorter than kHann: a per-grain Hann envelope instead of the
  12:src/LoopReader.h **** //    crossfade (granular self-scanning).
  13:src/LoopReader.h **** //  - Reverse flip and Retrigger jump operate on the window-local position and
  14:src/LoopReader.h **** //    reuse the crossfade against the dying trajectory.
  15:src/LoopReader.h **** //
  16:src/LoopReader.h **** // Window off == wlen == loopLen, wstart == 0: identical to a plain loop read.
  17:src/LoopReader.h **** // Read-side only — nothing is written back.
  18:src/LoopReader.h **** class LoopReader
  19:src/LoopReader.h **** {
  20:src/LoopReader.h ****   public:
  21:src/LoopReader.h ****     static constexpr int kXfadeMax = 128;  // ~2.7 ms @ 48 kHz
  22:src/LoopReader.h ****     static constexpr int kMinWin   = 1440; // 30 ms
  23:src/LoopReader.h ****     static constexpr int kHann     = 2880; // 60 ms — below this: Hann, not xfade
  24:src/LoopReader.h **** 
  25:src/LoopReader.h ****     void Init()
  26:src/LoopReader.h ****     {
  27:src/LoopReader.h ****         lpos_   = 0.0;
  28:src/LoopReader.h ****         speed_  = 1.0f;
  29:src/LoopReader.h ****         dir_    = 1;
  30:src/LoopReader.h ****         jleft_  = 0;
  31:src/LoopReader.h ****         wstart_ = 0.0;
  32:src/LoopReader.h ****         wlen_   = 1.0;
  33:src/LoopReader.h ****     }
  34:src/LoopReader.h **** 
  35:src/LoopReader.h ****     void SetSpeed(float mag) { speed_ = mag < 0.f ? -mag : mag; }
  36:src/LoopReader.h **** 
  37:src/LoopReader.h ****     void SetWindow(double start, double wlen)
  38:src/LoopReader.h ****     {
  39:src/LoopReader.h ****         wstart_ = start;
  40:src/LoopReader.h ****         wlen_   = wlen < 1.0 ? 1.0 : wlen;
  41:src/LoopReader.h ****         if(lpos_ >= wlen_)
  42:src/LoopReader.h ****             lpos_ = 0.0;
  43:src/LoopReader.h ****     }
  44:src/LoopReader.h **** 
  45:src/LoopReader.h ****     float  Speed() const { return speed_; }
  46:src/LoopReader.h ****     int    Dir() const { return dir_; }
  47:src/LoopReader.h ****     size_t LastIntPos() const { return last_ipos_; }
  48:src/LoopReader.h ****     double WinStart() const { return wstart_; }
  49:src/LoopReader.h ****     double WinLen() const { return wlen_; }
  50:src/LoopReader.h **** 
  51:src/LoopReader.h ****     float GlobalPhase(size_t loopLen) const
  52:src/LoopReader.h ****     {
  53:src/LoopReader.h ****         if(!loopLen)
  54:src/LoopReader.h ****             return 0.f;
  55:src/LoopReader.h ****         return (float)(Wrapf(wstart_ + lpos_, (double)loopLen) / (double)loopLen);
  56:src/LoopReader.h ****     }
  57:src/LoopReader.h **** 
  58:src/LoopReader.h ****     void Flip()
  59:src/LoopReader.h ****     {
  60:src/LoopReader.h ****         Arm();
  61:src/LoopReader.h ****         dir_ = -dir_;
  62:src/LoopReader.h ****     }
  63:src/LoopReader.h **** 
  64:src/LoopReader.h ****     void JumpLocal(double lp)
  65:src/LoopReader.h ****     {
  66:src/LoopReader.h ****         Arm();
  67:src/LoopReader.h ****         lpos_ = Wrapf(lp, wlen_);
ARM GAS  /var/folders/6p/t4mc160j56x7z12z3s_32gwm0000gn/T//ccHr3S02.s 			page 75


  68:src/LoopReader.h ****     }
  69:src/LoopReader.h **** 
  70:src/LoopReader.h ****     float Process(const LoopBuffer& b, size_t loopLen)
  71:src/LoopReader.h ****     {
  72:src/LoopReader.h ****         if(loopLen == 0)
  73:src/LoopReader.h ****             return 0.f;
  74:src/LoopReader.h **** 
  75:src/LoopReader.h ****         const double L = (double)loopLen;
  76:src/LoopReader.h ****         const double W = wlen_;
  77:src/LoopReader.h **** 
  78:src/LoopReader.h ****         int xf = (int)(W / 16.0);
  79:src/LoopReader.h ****         if(xf > kXfadeMax)
  80:src/LoopReader.h ****             xf = kXfadeMax;
  81:src/LoopReader.h ****         const bool useHann  = W < (double)kHann;
  82:src/LoopReader.h ****         const bool useXfade = !useHann && xf > 0 && W >= (double)(2 * xf);
  83:src/LoopReader.h **** 
  84:src/LoopReader.h ****         const double comp = useXfade ? (W - (double)xf) / W : 1.0;
  85:src/LoopReader.h ****         const double step = (double)speed_ * comp * (double)dir_;
  86:src/LoopReader.h **** 
  87:src/LoopReader.h ****         last_ipos_ = (size_t)Wrapf(wstart_ + lpos_, L);
  88:src/LoopReader.h **** 
  89:src/LoopReader.h ****         float out = ReadLocal(b, lpos_, dir_, L, W, xf, useXfade);
  90:src/LoopReader.h **** 
  91:src/LoopReader.h ****         if(jleft_ > 0)
  92:src/LoopReader.h ****         {
  93:src/LoopReader.h ****             float g   = (float)jleft_ / (float)kXfadeMax;
  94:src/LoopReader.h ****             float old = ReadLocal(b, jlpos_, jdir_, L, W, xf, useXfade);
  95:src/LoopReader.h ****             out       = old * EqPow(g) + out * EqPow(1.f - g);
  96:src/LoopReader.h ****             jlpos_    = Advance(jlpos_,
  97:src/LoopReader.h ****                              (double)speed_ * comp * (double)jdir_,
  98:src/LoopReader.h ****                              W,
  99:src/LoopReader.h ****                              xf,
 100:src/LoopReader.h ****                              useXfade);
 101:src/LoopReader.h ****             jleft_--;
 102:src/LoopReader.h ****         }
 103:src/LoopReader.h **** 
 104:src/LoopReader.h ****         if(useHann)
 105:src/LoopReader.h ****             out *= 0.5f - 0.5f * cosf(6.2831853f * (float)(lpos_ / W));
 106:src/LoopReader.h **** 
 107:src/LoopReader.h ****         lpos_ = Advance(lpos_, step, W, xf, useXfade);
 108:src/LoopReader.h ****         return out;
 109:src/LoopReader.h ****     }
 110:src/LoopReader.h **** 
 111:src/LoopReader.h ****   private:
 112:src/LoopReader.h ****     static inline float EqPow(float x)
 113:src/LoopReader.h ****     {
 114:src/LoopReader.h ****         return x <= 0.f ? 0.f : (x >= 1.f ? 1.f : sinf(1.57079633f * x));
 115:src/LoopReader.h ****     }
 116:src/LoopReader.h **** 
 117:src/LoopReader.h ****     static inline double Wrapf(double p, double m)
 118:src/LoopReader.h ****     {
 119:src/LoopReader.h ****         if(m <= 0.0)
 120:src/LoopReader.h ****             return 0.0;
 121:src/LoopReader.h ****         while(p >= m)
 122:src/LoopReader.h ****             p -= m;
 123:src/LoopReader.h ****         while(p < 0.0)
 124:src/LoopReader.h ****             p += m;
