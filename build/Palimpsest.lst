ARM GAS  /var/folders/6p/t4mc160j56x7z12z3s_32gwm0000gn/T//ccHr3S02.s 			page 230


   9:src/Engine.h  **** // M3 core: record -> playback with always-on feedback decay, non-destructive
  10:src/Engine.h  **** // playback edits (Reverse / Speed / Retrigger), and destructive edits (Overdub /
  11:src/Engine.h  **** // Substitute) that ride the Snapshot copy-on-write layer, with one-deep Undo.
  12:src/Engine.h  **** // One mono voice.
  13:src/Engine.h  **** class Engine
  14:src/Engine.h  **** {
  15:src/Engine.h  ****   public:
  16:src/Engine.h  ****     enum class State
  17:src/Engine.h  ****     {
  18:src/Engine.h  ****         EMPTY,
  19:src/Engine.h  ****         REC_FIRST,
  20:src/Engine.h  ****         PLAYING,
  21:src/Engine.h  ****     };
  22:src/Engine.h  **** 
  23:src/Engine.h  ****     void Init(LoopBuffer* loop, Snapshot* snap, float sample_rate)
  24:src/Engine.h  ****     {
  25:src/Engine.h  ****         loop_       = loop;
  26:src/Engine.h  ****         snap_       = snap;
  27:src/Engine.h  ****         sr_         = sample_rate;
  28:src/Engine.h  ****         state_      = State::EMPTY;
  29:src/Engine.h  ****         wpos_       = 0.0;
  30:src/Engine.h  ****         len_        = 0;
  31:src/Engine.h  ****         fb_         = 1.0f;
  32:src/Engine.h  ****         decay_pos_  = 0;
  33:src/Engine.h  ****         od_         = false;
  34:src/Engine.h  ****         sub_        = false;
  35:src/Engine.h  ****         sub_commit_ = false;
  36:src/Engine.h  ****         reader_.Init();
  37:src/Engine.h  ****     }
  38:src/Engine.h  **** 
  39:src/Engine.h  ****     // ---- performance controls ----------------------------------------------
  40:src/Engine.h  ****     void SetFeedback(float fb) { fb_ = fb; }
  41:src/Engine.h  ****     void SetSpeed(float mag) { reader_.SetSpeed(mag); }
  42:src/Engine.h  **** 
  43:src/Engine.h  ****     void SetReverse(bool rev)
  44:src/Engine.h  ****     {
  45:src/Engine.h  ****         if(state_ != State::PLAYING)
  46:src/Engine.h  ****             return;
  47:src/Engine.h  ****         if(rev != (reader_.Dir() < 0))
  48:src/Engine.h  ****             reader_.Flip();
  49:src/Engine.h  ****     }
  50:src/Engine.h  **** 
  51:src/Engine.h  ****     void Retrigger()
  52:src/Engine.h  ****     {
  53:src/Engine.h  ****         if(state_ == State::PLAYING)
  54:src/Engine.h  ****             reader_.JumpLocal(0.0); // window start
  55:src/Engine.h  ****     }
  56:src/Engine.h  **** 
  57:src/Engine.h  ****     // startNorm, lenNorm in 0..1 (knob + summed CV). lenNorm at max -> window
  58:src/Engine.h  ****     // off. Length is exponential from kMinWin to the whole loop.
  59:src/Engine.h  ****     void SetWindow(float startNorm, float lenNorm)
  60:src/Engine.h  ****     {
  61:src/Engine.h  ****         if(state_ != State::PLAYING
  62:src/Engine.h  ****            || len_ < (size_t)(2 * LoopReader::kMinWin))
  63:src/Engine.h  ****             return;
  64:src/Engine.h  ****         double wlen;
  65:src/Engine.h  ****         if(lenNorm >= 0.98f)
ARM GAS  /var/folders/6p/t4mc160j56x7z12z3s_32gwm0000gn/T//ccHr3S02.s 			page 231


  66:src/Engine.h  ****             wlen = (double)len_;
  67:src/Engine.h  ****         else
  68:src/Engine.h  ****         {
  69:src/Engine.h  ****             double f = (double)LoopReader::kMinWin
  70:src/Engine.h  ****                        * powf((float)len_ / (float)LoopReader::kMinWin, lenNorm);
  71:src/Engine.h  ****             if(f < (double)LoopReader::kMinWin)
  72:src/Engine.h  ****                 f = (double)LoopReader::kMinWin;
  73:src/Engine.h  ****             if(f > (double)len_)
  74:src/Engine.h  ****                 f = (double)len_;
  75:src/Engine.h  ****             wlen = f;
  76:src/Engine.h  ****         }
  77:src/Engine.h  ****         reader_.SetWindow((double)startNorm * (double)len_, wlen);
  78:src/Engine.h  ****     }
  79:src/Engine.h  **** 
  80:src/Engine.h  ****     // Overdub: additive, always destructive+undoable. engaged = latch|hold|gate.
  81:src/Engine.h  ****     void Overdub(bool engaged)
  82:src/Engine.h  ****     {
  83:src/Engine.h  ****         if(state_ != State::PLAYING)
  84:src/Engine.h  ****         {
  85:src/Engine.h  ****             od_ = false;
  86:src/Engine.h  ****             return;
  87:src/Engine.h  ****         }
  88:src/Engine.h  ****         if(engaged && !od_)
  89:src/Engine.h  ****         {
  90:src/Engine.h  ****             snap_->BeginTake();
  91:src/Engine.h  ****             od_ = true;
  92:src/Engine.h  ****         }
  93:src/Engine.h  ****         else if(!engaged && od_)
  94:src/Engine.h  ****         {
  95:src/Engine.h  ****             snap_->Commit();
  96:src/Engine.h  ****             od_ = false;
  97:src/Engine.h  ****         }
  98:src/Engine.h  ****     }
  99:src/Engine.h  **** 
 100:src/Engine.h  ****     // Substitute: replace. commit_intent true (latched) -> keep + snapshot for
 101:src/Engine.h  ****     // Undo; false (held / clocked gate) -> revert on release.
 102:src/Engine.h  ****     void Substitute(bool engaged, bool commit_intent)
 103:src/Engine.h  ****     {
 104:src/Engine.h  ****         if(state_ != State::PLAYING)
 105:src/Engine.h  ****         {
 106:src/Engine.h  ****             sub_ = false;
 107:src/Engine.h  ****             return;
 108:src/Engine.h  ****         }
 109:src/Engine.h  ****         if(engaged && !sub_)
 110:src/Engine.h  ****         {
 111:src/Engine.h  ****             snap_->BeginTake();
 112:src/Engine.h  ****             sub_        = true;
 113:src/Engine.h  ****             sub_commit_ = false;
 114:src/Engine.h  ****         }
 115:src/Engine.h  ****         if(engaged)
 116:src/Engine.h  ****             sub_commit_ |= commit_intent;
 117:src/Engine.h  ****         if(!engaged && sub_)
 118:src/Engine.h  ****         {
 119:src/Engine.h  ****             if(sub_commit_)
 120:src/Engine.h  ****                 snap_->Commit();
 121:src/Engine.h  ****             else
 122:src/Engine.h  ****                 snap_->RevertTake(*loop_);
ARM GAS  /var/folders/6p/t4mc160j56x7z12z3s_32gwm0000gn/T//ccHr3S02.s 			page 232


 123:src/Engine.h  ****             sub_ = false;
 124:src/Engine.h  ****         }
 125:src/Engine.h  ****     }
 126:src/Engine.h  **** 
 127:src/Engine.h  ****     void Undo()
 128:src/Engine.h  ****     {
 129:src/Engine.h  ****         if(state_ == State::PLAYING && snap_->CanUndo())
 130:src/Engine.h  ****             snap_->UndoRedo(*loop_);
 131:src/Engine.h  ****     }
 132:src/Engine.h  **** 
 133:src/Engine.h  ****     // EMPTY -> REC_FIRST -> PLAYING -> EMPTY
 134:src/Engine.h  ****     void TrigRecord()
 135:src/Engine.h  ****     {
 136:src/Engine.h  ****         switch(state_)
 137:src/Engine.h  ****         {
 138:src/Engine.h  ****             case State::EMPTY:
 139:src/Engine.h  ****                 wpos_  = 0.0;
 140:src/Engine.h  ****                 len_   = 0;
 141:src/Engine.h  ****                 state_ = State::REC_FIRST;
 142:src/Engine.h  ****                 break;
 143:src/Engine.h  ****             case State::REC_FIRST:
 144:src/Engine.h  ****                 len_ = (size_t)wpos_;
 145:src/Engine.h  ****                 if(len_ < kMinLen)
 146:src/Engine.h  ****                 {
 147:src/Engine.h  ****                     state_ = State::EMPTY;
 148:src/Engine.h  ****                 }
 149:src/Engine.h  ****                 else
 150:src/Engine.h  ****                 {
 151:src/Engine.h  ****                     reader_.Init();
 152:src/Engine.h  ****                     reader_.SetSpeed(1.0f);
 153:src/Engine.h  ****                     reader_.SetWindow(0.0, (double)len_);
 154:src/Engine.h  ****                     decay_pos_ = 0;
 155:src/Engine.h  ****                     state_     = State::PLAYING;
 156:src/Engine.h  ****                 }
 157:src/Engine.h  ****                 break;
 158:src/Engine.h  ****             case State::PLAYING:
 159:src/Engine.h  ****                 od_ = sub_ = false;
 160:src/Engine.h  ****                 state_     = State::EMPTY;
 161:src/Engine.h  ****                 break;
 162:src/Engine.h  ****         }
 163:src/Engine.h  ****     }
