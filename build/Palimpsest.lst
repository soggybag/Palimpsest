   1:src/LoopBuffer.h **** #pragma once
   2:src/LoopBuffer.h **** #include <cstddef>
   3:src/LoopBuffer.h **** #include <cstdint>
   4:src/LoopBuffer.h **** 
   5:src/LoopBuffer.h **** // int16 loop store with a 4-point Hermite interpolated read.
   6:src/LoopBuffer.h **** //
   7:src/LoopBuffer.h **** // Process path is float; storage is int16 (half the SDRAM, half the bandwidth).
   8:src/LoopBuffer.h **** // The backing memory is supplied by the caller — the SDRAM array lives in
   9:src/LoopBuffer.h **** // Palimpsest.cpp so this class stays allocation-free and testable.
  10:src/LoopBuffer.h **** class LoopBuffer
  11:src/LoopBuffer.h **** {
  12:src/LoopBuffer.h ****   public:
  13:src/LoopBuffer.h ****     void Init(int16_t* mem, size_t capacity)
  14:src/LoopBuffer.h ****     {
  15:src/LoopBuffer.h ****         buf_      = mem;
  16:src/LoopBuffer.h ****         capacity_ = capacity;
  17:src/LoopBuffer.h ****     }
  18:src/LoopBuffer.h **** 
  19:src/LoopBuffer.h ****     size_t Capacity() const { return capacity_; }
  20:src/LoopBuffer.h **** 
  21:src/LoopBuffer.h ****     // One-time clear. SDRAM contents are undefined at boot; call once in main().
  22:src/LoopBuffer.h ****     void ClearTo(size_t n)
  23:src/LoopBuffer.h ****     {
  24:src/LoopBuffer.h ****         if(n > capacity_)
  25:src/LoopBuffer.h ****             n = capacity_;
  26:src/LoopBuffer.h ****         for(size_t i = 0; i < n; i++)
  27:src/LoopBuffer.h ****             buf_[i] = 0;
  28:src/LoopBuffer.h ****     }
  29:src/LoopBuffer.h **** 
  30:src/LoopBuffer.h ****     static inline float S2F(int16_t s) { return (float)s * (1.0f / 32768.0f); }
  31:src/LoopBuffer.h **** 
  32:src/LoopBuffer.h ****     static inline int16_t F2S(float f)
  33:src/LoopBuffer.h ****     {
  34:src/LoopBuffer.h ****         if(f > 1.0f)
  35:src/LoopBuffer.h ****             f = 1.0f;
  36:src/LoopBuffer.h ****         if(f < -1.0f)
  37:src/LoopBuffer.h ****             f = -1.0f;
  38:src/LoopBuffer.h ****         return (int16_t)(f * 32767.0f);
  39:src/LoopBuffer.h ****     }
  40:src/LoopBuffer.h **** 
  41:src/LoopBuffer.h ****     inline float ReadRaw(size_t i) const { return S2F(buf_[i]); }
  42:src/LoopBuffer.h ****     inline void  Write(size_t i, float v) { buf_[i] = F2S(v); }
ARM GAS  /var/folders/6p/t4mc160j56x7z12z3s_32gwm0000gn/T//ccHr3S02.s 			page 79


