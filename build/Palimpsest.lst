 169:Palimpsest.cpp **** 
 170:Palimpsest.cpp ****     const char* label = "EMPTY";
 171:Palimpsest.cpp ****     switch(engine.GetState())
 172:Palimpsest.cpp ****     {
 173:Palimpsest.cpp ****         case Engine::State::REC_FIRST: label = "REC"; break;
 174:Palimpsest.cpp ****         case Engine::State::PLAYING: label = "PLAY"; break;
 175:Palimpsest.cpp ****         default: break;
 176:Palimpsest.cpp ****     }
 177:Palimpsest.cpp ****     hw.display.SetCursor(0, 0);
