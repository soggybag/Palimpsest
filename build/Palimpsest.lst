  55:../../DaisyExamples/DaisySP/Source/Utility/dsp.h ****     asm("vminnm.f32 %[d], %[n], %[m]" : [d] "=t"(r) : [n] "t"(a), [m] "t"(b) :);
  56:../../DaisyExamples/DaisySP/Source/Utility/dsp.h **** #else
  57:../../DaisyExamples/DaisySP/Source/Utility/dsp.h ****     r = (a < b) ? a : b;
