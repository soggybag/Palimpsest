 170:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     */
 171:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     void SetCursor(uint16_t x, uint16_t y)
 172:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     {
 173:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         currentX_ = (x >= Width()) ? Width() - 1 : x;
 174:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****         currentY_ = (y >= Height()) ? Height() - 1 : y;
 175:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     }
 176:../../DaisyExamples/libDaisy/src/hid/disp/display.h **** 
 177:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     /** 
 178:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     Writes the current display buffer to the OLED device using SPI or I2C depending on 
 179:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     how the object was initialized.
 180:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     */
 181:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     virtual void Update() = 0;
 182:../../DaisyExamples/libDaisy/src/hid/disp/display.h **** 
 183:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****   protected:
 184:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     uint16_t currentX_;
 185:../../DaisyExamples/libDaisy/src/hid/disp/display.h ****     uint16_t currentY_;
 186:../../DaisyExamples/libDaisy/src/hid/disp/display.h **** };
