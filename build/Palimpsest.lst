  91:src/Snapshot.h ****     // End the take, keeping the changes. The take's snapshots replace the
  92:src/Snapshot.h ****     // previous undo set.
  93:src/Snapshot.h ****     void Commit()
  94:src/Snapshot.h ****     {
  95:src/Snapshot.h ****         for(int i = 0; i < undo_n_; i++)
  96:src/Snapshot.h ****         {
  97:src/Snapshot.h ****             uint16_t s = undo_slot_[undo_blk_[i]];
  98:src/Snapshot.h ****             if(s != kNone)
  99:src/Snapshot.h ****             {
 100:src/Snapshot.h ****                 slot_kept_[s]           = false;
 101:src/Snapshot.h ****                 slot_owner_[s]          = kNone;
 102:src/Snapshot.h ****                 undo_slot_[undo_blk_[i]] = kNone;
 103:src/Snapshot.h ****             }
 104:src/Snapshot.h ****         }
 105:src/Snapshot.h ****         undo_n_ = 0;
 106:src/Snapshot.h ****         for(int i = 0; i < take_n_; i++)
 107:src/Snapshot.h ****         {
 108:src/Snapshot.h ****             uint16_t blk = take_blk_[i];
 109:src/Snapshot.h ****             uint16_t s   = take_slot_[blk];
 110:src/Snapshot.h ****             take_slot_[blk] = kNone;
 111:src/Snapshot.h ****             if(s == kNone)
 112:src/Snapshot.h ****                 continue;
 113:src/Snapshot.h ****             slot_kept_[s]   = true;
 114:src/Snapshot.h ****             undo_slot_[blk] = s;
 115:src/Snapshot.h ****             undo_blk_[undo_n_++] = blk;
 116:src/Snapshot.h ****         }
ARM GAS  /var/folders/6p/t4mc160j56x7z12z3s_32gwm0000gn/T//ccHr3S02.s 			page 245


 117:src/Snapshot.h ****         take_n_ = 0;
 118:src/Snapshot.h ****         undone_ = false;
 119:src/Snapshot.h ****     }
